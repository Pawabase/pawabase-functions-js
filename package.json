{
  "name": "@pawabase/functions",
  "version": "0.1.0",
  "description": "Write, test and deploy Pawabase functions in TypeScript: the function kit, test helpers and the deploy CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pawabase-functions": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "deno",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/finish-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"dist-test/test/**/*.test.js\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "pawabase",
    "functions",
    "serverless",
    "deno",
    "typescript"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "@pawabase/client": "file:../js"
  },
  "peerDependencies": {
    "@pawabase/client": ">=0.1.0 <0.2.0"
  }
}
